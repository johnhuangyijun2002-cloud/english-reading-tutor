# ============================================
# English Reader — 环境变量模板
# 复制为 .env 后填入真实值（.env 不会上传到 Git）
# 部署到 Railway / Render 等平台时，在平台的面板里设置这些变量
# ============================================

# ---- 必填 ----

# Supabase Postgres 连接字符串
DATABASE_URL=postgresql://user:password@host:port/database

# Fernet 加密密钥，用于加密存储用户的 AI API Key
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Google OAuth 登录（可选，不配的话 Google 登录功能不生效）----

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- Sign in with Apple（可选，不配的话 Apple 登录功能不生效；iOS App 上架 App Store
# 强制要求——App 里已经有 Google 第三方登录，苹果审核规定必须同时提供 Apple 登录）----
#
# 这四个值都在 Apple Developer 后台(developer.apple.com/account)生成，跟 App 本身的
# Bundle ID(com.contextia.app)是两套不同的东西：
#   1. Certificates, Identifiers & Profiles → Identifiers → 新建一个 Services ID
#      (不是 App ID)，勾选 "Sign in with Apple"，配置 Domain 和 Return URL
#      (Return URL 填 https://你的域名/api/auth/apple/callback)——这个 Services ID
#      本身就是下面的 APPLE_SERVICES_ID
#   2. Certificates, Identifiers & Profiles → Keys → 新建一个 Key，勾选 "Sign in with
#      Apple"，下载生成的 .p8 私钥文件(只能下载一次，丢了要重新生成)，文件名里那串
#      就是 APPLE_KEY_ID
#   3. APPLE_TEAM_ID 在 Apple Developer 后台右上角账号信息里能看到(10 位字符)
#   4. APPLE_PRIVATE_KEY 是 .p8 文件的完整内容(包含 -----BEGIN PRIVATE KEY----- 那几行)；
#      如果部署平台的环境变量输入框不支持换行，把真正的换行替换成字面的 "\n" 粘贴进去也可以，
#      代码里会自动换回来
APPLE_TEAM_ID=your-apple-team-id
APPLE_SERVICES_ID=com.contextia.app.web
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---- Apple 内购/StoreKit（可选，不配的话 iOS Pro 订阅功能不生效；iOS App 保留付费能力，
# 不做免费版，Pro 订阅解锁"不用自己填 AI Key"）----
#
# 跟 Sign in with Apple 是分开的一套凭据，也是去 Apple Developer / App Store Connect 后台配：
#   1. App Store Connect → 用户和访问 → 集成(Integrations) → App Store Server API →
#      生成一个新 Key(类型选 "In-App Purchase")，下载 .p8 文件——文件名里那串就是
#      APPLE_IAP_KEY_ID
#   2. 同一个页面上能看到 Issuer ID(一串 UUID)，就是 APPLE_IAP_ISSUER_ID
#   3. APPLE_IAP_PRIVATE_KEY 是上面那个 .p8 文件的完整内容，格式要求跟 APPLE_PRIVATE_KEY
#      一样(真换行或者转义成 "\n" 都行)
#   4. App 首次在 App Store Connect 建好之后，App 信息页能看到一个 Apple ID(纯数字)，
#      填进 APPLE_APP_APPLE_ID——验证 Production 环境的收据需要这个；账号/App 还没建好
#      之前留空不影响开发，只是验证不了真实的生产订阅
#   5. APPLE_PRO_PRODUCT_ID 要跟 App Store Connect 里配置的订阅商品 Product ID 完全一致
#   6. APPLE_IAP_ROOT_CERTS_BASE64：去 https://www.apple.com/certificateauthority/
#      下载 "Apple Root CA - G3 Root"(.cer 文件)，转成一行 base64 填进来——这一步不需要
#      Apple Developer 账号，谁都能下载。转换命令(Linux/Mac)：
#      `base64 -i AppleRootCA-G3.cer | tr -d '\n'`
#   7. 部署好之后，回 App Store Connect → 这个 App → App 信息 → App Store Server
#      Notifications，把生产/沙盒的 URL 都填成 https://你的域名/api/iap/notifications——
#      这样订阅续费/取消/退款的时候 Apple 会主动推给后端，不用等用户重新打开 App
APPLE_IAP_KEY_ID=your-iap-key-id
APPLE_IAP_ISSUER_ID=your-issuer-id-uuid
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_APP_APPLE_ID=
APPLE_PRO_PRODUCT_ID=com.contextia.app.pro.monthly
APPLE_IAP_ROOT_CERTS_BASE64=

# ---- Cloudflare Turnstile 人机验证（可选，不配则跳过验证）----

TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ---- Google Sheets 同步（可选，仅主账号可用）----

# 把 Google Sheet 的 Apps Script 部署成 Web App 之后，把网址粘贴到这里
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# 和 apps_script/Code.gs 里配好的 token 一致即可
SHEETS_TOKEN=your-sheets-token

# ---- Resend 密码找回邮件（可选，不配的话"忘记密码"点了会提示还没配置）----
# 去 https://resend.com 注册，Domains 里加你的域名并按提示加 DNS 记录验证，
# 验证通过后 API Keys 里建一个 key。RESEND_FROM_EMAIL 要用已验证域名下的地址，
# 没验证域名之前只能发到你自己注册 Resend 时用的那个邮箱（用官方的 onboarding@resend.dev 测试用发件地址即可）。

RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=Contextia <noreply@your-domain.com>

# ---- 公共体验额度（可选）----
# 没填自己 AI Key 的新用户，可以先用站长的 key 免费试用几次。
# 不配置的话，用户必须自己填 key 才能用 AI 功能。

HOUSE_AI_PROVIDER=deepseek
HOUSE_AI_API_KEY=sk-your-deepseek-key
HOUSE_MONTHLY_BUDGET_USD=5

# ---- 数据目录（可选）----
# 部署到 Railway 时指到挂载的持久化磁盘，本地开发用默认的 data/ 即可
# DATA_DIR=/data

# ---- Pro 自愿支持链接（可选）----
# 在 Stripe 后台创建一个 Payment Link 后粘贴到这里，App 内"升级到 Pro"面板
# 会显示一个自愿支持入口；不配置就不显示这个入口，不影响邮箱登记功能。
# STRIPE_SUPPORT_LINK_URL=https://buy.stripe.com/xxxxxx
