# ============================================
# English Reader — 环境变量模板
# 复制为 .env 后填入真实值（.env 不会上传到 Git）
# 部署到 Railway / Render 等平台时，在平台的面板里设置这些变量
# ============================================

# ---- 必填 ----

# Supabase Postgres 连接字符串
DATABASE_URL=postgresql://user:password@host:port/database

# Fernet 加密密钥，用于加密存储用户的 AI API Key
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Google OAuth 登录（可选，不配的话 Google 登录功能不生效）----

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- Cloudflare Turnstile 人机验证（可选，不配则跳过验证）----

TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ---- Google Sheets 同步（可选，仅主账号可用）----

# 把 Google Sheet 的 Apps Script 部署成 Web App 之后，把网址粘贴到这里
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# 和 apps_script/Code.gs 里配好的 token 一致即可
SHEETS_TOKEN=your-sheets-token

# ---- Resend 密码找回邮件（可选，不配的话"忘记密码"点了会提示还没配置）----
# 去 https://resend.com 注册，Domains 里加你的域名并按提示加 DNS 记录验证，
# 验证通过后 API Keys 里建一个 key。RESEND_FROM_EMAIL 要用已验证域名下的地址，
# 没验证域名之前只能发到你自己注册 Resend 时用的那个邮箱（用官方的 onboarding@resend.dev 测试用发件地址即可）。

RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=Contexta <noreply@your-domain.com>

# ---- 公共体验额度（可选）----
# 没填自己 AI Key 的新用户，可以先用站长的 key 免费试用几次。
# 不配置的话，用户必须自己填 key 才能用 AI 功能。

HOUSE_AI_PROVIDER=deepseek
HOUSE_AI_API_KEY=sk-your-deepseek-key
HOUSE_MONTHLY_BUDGET_USD=5

# ---- 数据目录（可选）----
# 部署到 Railway 时指到挂载的持久化磁盘，本地开发用默认的 data/ 即可
# DATA_DIR=/data
